# Generate a unique random secret for signed login sessions.
SESSION_SECRET=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://nazzelha.onrender.com

# Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login credentials from Meta for Developers.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# TikTok Login Kit credentials from TikTok for Developers.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Set a unique password before starting the app; never commit .env.
APP_PASSWORD=change-this-to-a-long-random-password
MAX_FILE_MB=500
MAX_DURATION_HOURS=3
JOB_TTL_MINUTES=20
MAX_ACTIVE_JOBS_PER_IP=2
MAX_ACTIVE_JOBS_GLOBAL=6

